# Umgebung für den selbst gehosteten Betrieb (ADR-0004, ADR-0005). Lokal mit `pnpm dev` braucht
# es nichts davon: Der Local Mode läuft ohne Mongo und ohne Login (Konzept Q30).

# Brand-Mongo: Tina-Index (Datenbank tinacms) und Login (Datenbank auth)
MONGODB_URI=mongodb://brand-mongo:27017

# Tina-GitHub-Provider: Fine-grained Token, contents:write nur auf alex-schwaiger/brand
GITHUB_TOKEN=
GITHUB_BRANCH=development

# Better Auth: Secret mit `openssl rand -base64 32` erzeugen; URL ohne Schrägstrich am Ende
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://brand.alexanderschwaiger.at

# Nur für `pnpm --filter site seed:user`, nicht im laufenden Container
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
