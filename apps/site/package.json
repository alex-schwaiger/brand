{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TINA_PUBLIC_IS_LOCAL=true tinacms dev -c \"next dev\"",
    "build": "next build",
    "tina:generate": "TINA_PUBLIC_IS_LOCAL=true tinacms build --local --skip-cloud-checks --skip-search-index",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "fetch-switzer": "node ../../scripts/fetch-switzer.mjs"
  },
  "dependencies": {
    "@alex-schwaiger/brand": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@tinacms/cli": "4.0.4",
    "@tinacms/datalayer": "3.0.0",
    "@tinacms/graphql": "4.1.0",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "mongodb": "^4.17.2",
    "mongodb-level": "0.0.4",
    "next": "^16.4.3",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tinacms": "3.15.0",
    "tinacms-gitprovider-github": "5.0.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.3"
  }
