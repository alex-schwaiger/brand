{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TINA_PUBLIC_IS_LOCAL=true tinacms dev -c \"next dev\"",
    "build": "next build",
    "tina:generate": "TINA_PUBLIC_IS_LOCAL=true tinacms build --local --skip-cloud-checks --skip-search-index",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed:user": "node scripts/seed-user.ts",
    "build:seed": "esbuild scripts/seed-user.ts --bundle --platform=node --format=esm --target=node24 --outfile=.seed/seed-user.mjs --log-level=warning --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --external:kerberos --external:snappy --external:@mongodb-js/zstd --external:mongodb-client-encryption --external:@aws-sdk/credential-providers --external:gcp-metadata --external:socks --external:aws4",
    "postinstall": "fumadocs-mdx",
    "fetch-switzer": "node ../../scripts/fetch-switzer.mjs"
  },
  "dependencies": {
    "@alex-schwaiger/brand": "workspace:*",
    "@better-auth/passkey": "1.7.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@tinacms/cli": "4.0.4",
    "@tinacms/datalayer": "3.0.0",
    "@tinacms/graphql": "4.1.0",
    "better-auth": "1.7.14",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "mongodb": "^7.8.0",
    "mongodb-level": "0.0.4",
    "next": "^16.4.3",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tinacms": "3.15.0",
    "tinacms-gitprovider-github": "5.0.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
