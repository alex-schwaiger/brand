# Vorlage für die Umgebungsvariablen in Dokploy. Echte Werte nie committen.

# Mongo (Container brand-mongo)
MONGO_INITDB_ROOT_USERNAME=brand
MONGO_INITDB_ROOT_PASSWORD=change-me

# Tina-Git-Provider: Fine-grained Token, nur contents:write auf alex-schwaiger/brand
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_xxx
GITHUB_OWNER=alex-schwaiger
GITHUB_REPO=brand
GITHUB_BRANCH=development

# Better Auth (Secret erzeugen mit: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=https://brand.alexanderschwaiger.at

# Seed-Benutzer (einziger Benutzer, Registrierung ist deaktiviert)
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me
